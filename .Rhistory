df_ts_tw <- calc_time_series(df_tweet = df_tweet, df_user_num = df_user_num, option = "twitter")
usethis::use_data(df_ts_tw, overwrite = T)
plot_time_series(df_ts_tw = df_ts_tw, option = "twitter", save = T)
summ_time_series_twitter(df_ts_tw = df_ts_tw)
df_ts_tw_proc <- calc_time_series(df_tweet = df_tweet, df_user_num = df_user_num, option = "twitter", process = T)
usethis::use_data(df_ts_tw_proc, overwrite = T)
plot_time_series(df_ts_tw = df_ts_tw_proc, option = "twitter", process = T, save = T)
summ_ts_spring(df_ts_tw = df_ts_tw)
plot_nab_map(df_nab = df_nab, save = T)
df_ts_nab <- calc_time_series(df_nab = df_nab, option = "nab")
usethis::use_data(df_ts_nab, overwrite = T)
plot_time_series(df_ts_nab = df_ts_nab, option = "nab", save = T)
df_ts_nab_proc <- calc_time_series(df_nab = df_nab, option = "nab", process = T)
usethis::use_data(df_ts_nab_proc, overwrite = T)
plot_time_series(df_ts_nab = df_ts_nab_proc, option = "nab", process = T, save = T)
(p_ts_compare <- plot_time_series(df_ts_tw = df_ts_tw_proc, df_ts_nab = df_ts_nab_proc, option = "compare", save = T))
df_st_tw <- calc_spatial_time_series(df_tweet = df_tweet, df_user_num = df_user_num, option = "twitter")
usethis::use_data(df_st_tw, overwrite = T)
df_st_metric_tw <- calc_spatiotemporal_metrics(df_st = df_st_tw)
plot_spatial_time_series(df_st_tw = df_st_tw, df_st_metric_tw = df_st_metric_tw, save = T, option = "twitter")
usethis::use_data(df_st_metric_tw, overwrite = T)
df_st_nab <- calc_spatial_time_series(df_nab = df_nab, option = "nab")
usethis::use_data(df_st_nab, overwrite = T)
df_st_metric_nab <- calc_spatiotemporal_metrics(df_st = df_st_nab)
plot_spatial_time_series(df_st_nab = df_st_nab, df_st_metric_nab = df_st_metric_nab, save = T, option = "nab")
usethis::use_data(df_st_metric_nab, overwrite = T)
#' @export
plot_phenology_metrics_compare <- function(df_st_metric_tw, df_st_metric_nab, metricoi = "mos", save = F) {
df_st_metric_compare <- full_join(
df_st_metric_tw %>%
filter(metric == metricoi) %>%
select(state, state_name, lon, lat, tweet = doy),
df_st_metric_nab %>%
filter(metric == metricoi) %>%
select(state, state_name, lon, lat, pollen = doy),
by = c("state", "state_name", "lon", "lat")
)
p_st_gradient <- df_st_metric_compare %>%
gather(key = "data", value = "doy", -state, -state_name, -lon, -lat) %>%
mutate(data = factor(data,
levels = c("tweet", "pollen"),
labels = c(
"tweet count",
"pollen concentration"
)
)) %>%
ggplot() +
geom_point(aes(x = lat, y = doy, col = data, group = data)) +
geom_smooth(aes(x = lat, y = doy, col = data, group = data), method = "lm", se = F) +
scale_color_manual(values = c("tweet count" = "dark blue", "pollen concentration" = "dark orange")) +
ggpubr::stat_cor(
aes(
x = lat, y = doy, col = data, group = data,
label = paste(after_stat(r.label), after_stat(p.label), sep = "~`,`~")
),
p.accuracy = 0.001,
digits = 3,
show.legend = FALSE
) +
labs(
x = "Latitude of state (° N)",
y = "Time of spring pollen peak\n(day of year)",
col = "Data source"
) +
theme(legend.position = "bottom")
v_state_label <- c("Texas", "Georgia", "North Carolina", "California", "New York")
p_st_corr <- df_st_metric_compare %>%
drop_na() %>%
mutate(state_label = case_when(
state_name %in% v_state_label ~ state_name
)) %>%
ggplot() +
geom_point(aes(x = pollen, y = tweet)) +
ggrepel::geom_label_repel(
aes(
x = pollen,
y = tweet,
label = state_label
),
size = 3,
color = "black",
fill = NA,
min.segment.length = 0,
max.overlaps = Inf,
label.padding = unit(.25, "lines"),
label.size = NA
) +
# ggrepel::geom_label_repel(aes(x = pollen, y = tweet, label = state_label), fill = NA) +
geom_smooth(aes(x = pollen, y = tweet), method = "lm", se = F) +
ggpubr::stat_cor(
aes(
x = pollen, y = tweet,
label = paste(after_stat(r.label), after_stat(p.label), sep = "~`,`~")
),
p.accuracy = 0.001,
digits = 3
) +
labs(
x = "Time of spring pollen peak\nderived from natural pollen phenology\n(day of year)",
y = "Time of spring pollen peak\nderived from Twitter pollen phenology\n(day of year)",
col = "Phenological metric"
)
if (save) {
ggsave(
plot = p_st_gradient,
filename = "alldata/output/figures/supp/phenology_metrics_gradient.png",
width = 6,
height = 6,
device = png,
type = "cairo"
)
ggsave(
plot = p_st_corr,
filename = "alldata/output/figures/supp/phenology_metrics_corr.png",
width = 6,
height = 6,
device = png,
type = "cairo"
)
}
out <- list(
gradient = p_st_gradient,
corr = p_st_corr
)
return(out)
}
(p_st_compare <- plot_spatial_time_series(df_st_tw = df_st_tw, df_st_nab = df_st_nab, df_st_metric_tw = df_st_metric_tw, df_st_metric_nab = df_st_metric_nab, save = T, option = "compare"))
(p_metrics_compare <- plot_phenology_metrics_compare(df_st_metric_tw = df_st_metric_tw, df_st_metric_nab = df_st_metric_nab, metricoi = "mos", save = T))
(p_metrics_compare <- plot_phenology_metrics_compare(df_st_metric_tw = df_st_metric_tw, df_st_metric_nab = df_st_metric_nab, metricoi = "mos", save = T))
plot_phenology_compare(p_ts_compare = p_ts_compare, p_st_compare = p_st_compare, p_metrics_compare = p_metrics_compare, save = T)
